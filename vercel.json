{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "redirects": [
    { "source": "/AbdulrahmanUniProjectAdmin", "destination": "/AbdulrahmanUniProjectAdmin/", "permanent": false },
    { "source": "/platform", "destination": "/platform/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/assets/cards/:path*", "destination": "https://academia-assets.pages.dev/assets/cards/:path*" },
    { "source": "/assets/emoji/:path*", "destination": "https://academia-assets.pages.dev/assets/emoji/:path*" },
    { "source": "/api/:path*", "destination": "/api/route" }
  ]
}
